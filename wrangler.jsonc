{
  // The name of your Cloudflare Workers project
  "name": "kvideo",
  // The compatibility date for the Cloudflare Workers runtime
  "compatibility_date": "2025-01-01",
  // Enable Node.js compatibility mode (required for Next.js)
  "compatibility_flags": ["nodejs_compat"],
  // Main entry point generated by @opennextjs/cloudflare build
  "main": ".open-next/worker.js",
  // Assets directory for static files
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
